; SAP NWRFC SDK import library definition file
;
; Purpose: CI cannot ship the copyrighted sapnwrfc.dll, but MSVC link.exe
; must resolve every symbol at link time (unlike Linux/macOS, which can
; defer to runtime). This file lists every function declared in ffi.rs
; under `extern "system"`, so `lib.exe` can produce a hollow import
; library; users mount the real sapnwrfc.dll at runtime.
;
; Regenerate (Windows MSVC environment):
;   lib /def:sapnwrfc.def /machine:x64 /out:sapnwrfc.lib
;
; x64 MSVC has no name decoration (unlike x86 stdcall's @N suffix);
; function names are listed verbatim. When adding FFI symbols, append
; them here as well.
;
; WARNING: keep ALL comments ASCII-only. lib.exe parses this file with
; the system ANSI codepage; UTF-8 CJK comments make a GBK-codepage
; (Chinese Windows) lib.exe swallow the newline and silently DROP the
; symbol on the next line (verified: 3 symbols lost that way).

LIBRARY sapnwrfc.dll
EXPORTS
    ; connection management
    RfcOpenConnection
    RfcCloseConnection
    ; function metadata & instances
    RfcGetFunctionDesc
    RfcCreateFunction
    RfcDestroyFunction
    ; string / integer accessors
    RfcSetString
    RfcGetString
    RfcSetInt
    RfcGetInt
    ; floating point
    RfcSetFloat
    RfcGetFloat
    ; 8-byte integers
    RfcSetInt8
    RfcGetInt8
    ; binary variable-length (XSTRING)
    RfcSetXString
    RfcGetXString
    ; remote call execution
    RfcInvoke
    ; table operations
    RfcGetTable
    ; structures
    RfcGetStructure
    RfcGetRowCount
    RfcMoveTo
    RfcGetCurrentRow
    RfcAppendNewRow
    ; function parameter metadata
    RfcGetParameterCount
    RfcGetParameterDescByIndex
    ; structure field metadata
    RfcGetFieldDescByIndex
    RfcGetFieldCount
    ; DDIC type descriptor (lookup structure/table by exact name)
    RfcGetTypeDesc
    ; server-side API
    RfcRegisterServer
    RfcListenAndDispatch
    RfcInstallServerFunction
    RfcCreateFunctionDesc
    RfcAddParameter
    RfcDestroyFunctionDesc
    RfcGetFunctionName
    RfcDescribeFunction
    ; repository descriptor cache management
    ; (post-write invalidation: GetCached to probe, then Remove)
    RfcGetCachedFunctionDesc
    RfcRemoveFunctionDesc
    RfcGetCachedTypeDesc
    RfcRemoveTypeDesc
