# ──────────────────────────────────────────────────────────────
# SAP 连接参数（本地运行 & Docker 都需要）
# ──────────────────────────────────────────────────────────────
SAP_ASHOST=localhost
SAP_SYSNR=00
SAP_CLIENT=001
SAP_USER=DEVELOPER
SAP_PASSWD=your-password-here

# 语言（可选，默认 EN）
SAP_LANG=EN

# HTTP 服务监听地址（本地运行用；Docker 内部固定监听 0.0.0.0:3000）
SAP_LISTEN_ADDR=127.0.0.1:3000

# SAP 连接池大小（可选，默认 8）。并发 SAP 调用数；超出的请求排队等待。
SAP_POOL_SIZE=8

# 空闲连接借出前校验阈值（可选，默认 30s，≥1）。连接空闲超过该时长后，
# 下次借出前先 RFC_PING 校验，SAP 端已断开的僵尸连接被提前丢弃重建，
# 避免「空闲后的首批请求撞 RFC_INVALID_HANDLE」。设 0 = 禁用校验。
# 背景：连接静默死亡与 SAP 重启无关——网关空闲断连策略（gw/conn_disconnect，
# 依系统配置）、笔记本休眠/唤醒、Docker/VM 暂停、VPN 重连、防火墙空闲超时
# 都会产生半开连接，池端收不到任何通知。
# SAP_POOL_IDLE_VALIDATE_SECS=30

# 只读模式（可选，默认关闭）：设 1/true 后网关写端点返回 403——
# /api/objects 的 PUT source 与 POST replace、/api/adt 的非读方法全部拦截；
# POST syntax（不落库）与 POST /api/rfc 不受影响（RFC 无法按函数名区分读写，
# SAP 端授权才是真正的边界）。
# SAP_READ_ONLY=1

# API 认证（可选）：设置后 /api/* 端点要求 Authorization: Bearer <token>。
# 留空/不设置 = 免鉴权（仅本机访问时安全）。
# ⚠️ 一旦把服务暴露到网络（SAP_LISTEN_ADDR=0.0.0.0 或 Docker），务必设置，
#    否则任何能访问端口的人都能以 SAP_USER 权限调用任意 RFC。
# 探针端点 /health、/ready 与公开页 /、/agents.md 始终免鉴权。
# SAP_API_KEY=change-me-to-a-long-random-secret

# 单次 SAP 调用的全局超时（可选，默认 60s，≥1）。超时返回 HTTP 504。
# POST /api/rfc 还支持 per-request 覆盖：请求体加 "timeout_secs": <秒数>。
SAP_REQUEST_TIMEOUT_SECS=60

# /api 限流（可选，默认不限流）：按调用方 IP 的每秒请求数，≥1 启用。超限返回 429。
# SAP_RATE_LIMIT_RPS=20

# 新版本检查（可选，默认开启）：启动时与每 24h 向 api.github.com 查询本仓库最新
# Release（单个匿名 GET，无遥测），结果展示在 /api/version 的 latest 块与首页页脚。
# 设 off / false / 0 / no 可完全关闭（无外联）。
# SAP_UPDATE_CHECK=on

# ADT REST 代理（/api/adt/**，可选）。基地址默认 http://<SAP_ASHOST>:50000，
# 设为空串禁用。需要目标系统 ICF 上的 ADT 服务（/sap/bc/adt）处于激活状态。
# SAP_ADT_BASE_URL=http://localhost:50000
# ADT 认证（可选，默认沿用 SAP_USER / SAP_PASSWD）
# SAP_ADT_USER=
# SAP_ADT_PASSWD=

# ──────────────────────────────────────────────────────────────
# 仅 Docker 部署时需要（docker compose up 用）
# ──────────────────────────────────────────────────────────────

# 宿主机上 Linux 版 SAP SDK 目录的【绝对路径】。
# 该目录会被只读挂载到容器的 /app/nwrfcsdk。
# 目录结构需与仓库 nwrfcsdk/ 一致，含 lib/linux-x86_64/libsapnwrfc.so。
# 示例：
#   Windows: SAP_SDK_HOST_PATH=C:\Users\you\sap-sdk
#   Linux:   SAP_SDK_HOST_PATH=/opt/sap/nwrfcsdk
# 本地运行（非 Docker）时无需配置此项。
SAP_SDK_HOST_PATH=./nwrfcsdk

# 宿主机映射端口（默认 3000）。改此值不影响容器内监听。
SAP_HOST_PORT=3000

# 日志级别（tracing env_filter）。可选值：error/warn/info/debug/trace
RUST_LOG=info

# 运行模式（可选）：
#   client（默认）：仅 HTTP server（HTTP→SAP）
#   server：仅 SAP server（被 SAP 回调→webhook，需配 servers.toml）
#   both：两者并行
# SAP_ROLE=client

# Server 模式的配置文件路径（可选，默认 servers.toml）
# SERVERS_CONFIG=servers.toml
